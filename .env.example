# Project Accountants Learning Platform - frontend configuration (public values only).
# Copy to .env.local. Never put the Supabase service-role key here.

# Backend API base URL
VITE_API_URL=http://localhost:4000/api/v1

# Supabase → Project Settings → API Keys / Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key (safe for browsers; RLS blocks direct table access)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Show the "Sign in with Microsoft" button (enable once Azure SSO is configured in Supabase)
VITE_ENABLE_MICROSOFT_SSO=false

# DEV ONLY: run against backend `npm run demo` (in-memory data, account picker, no Supabase needed).
# Ignored by production builds.
VITE_DEMO_MODE=false
